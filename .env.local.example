# OpenPhone API — for auto-syncing calls and SMS to contact log
# Get your key at: https://my.openphone.com/settings/api
OPENPHONE_API_KEY=your_openphone_api_key_here
OPENPHONE_NUMBER_ID=PNyour_number_id_here

# Resend API — for morning email digest delivery
# Get your key at: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here
